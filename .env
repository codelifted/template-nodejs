# User Management Client (client_credentials flow)
USER_MGMT_KEYCLOAK_URL=http://localhost:8080/auth
USER_MGMT_KEYCLOAK_REALM=myrealm
USER_MGMT_KEYCLOAK_CLIENT_ID=user-management-client
USER_MGMT_KEYCLOAK_CLIENT_SECRET=your-user-mgmt-client-secret

# Authentication Client (password grant flow)
AUTH_KEYCLOAK_URL=http://localhost:8080/auth
AUTH_KEYCLOAK_REALM=myrealm
AUTH_KEYCLOAK_CLIENT_ID=saas-client
AUTH_KEYCLOAK_CLIENT_SECRET=your-saas-client-secret